# Claude Code 로컬 세션/도구 상태 (공유 불필요, 세션마다 바뀜)
.claude/

# macOS
.DS_Store

# Python / backend
backend/.venv/
backend/db/*.db
backend/db/*.db.bak_*
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / frontend (frontend/.gitignore가 상세 항목을 다루지만 루트에서도 안전망으로 둠)
frontend/node_modules/
frontend/.next/

